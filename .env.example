# Для локальной и GitVerse Pages сборки секретные переменные не нужны.
#
# Публичный Yandex OAuth ClientID указывается в public/runtime-config.js.
# Access token пользователя приложение сохраняет только в IndexedDB браузера;
# никогда не добавляйте его в .env, Git или runtime-config.js.
#
# Резервная ChatGPT Sites сборка получает D1/R2 через server-side bindings из
# .openai/hosting.json и также не требует клиентских секретов.
