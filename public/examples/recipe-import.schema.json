{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/maminy-recipes-import.schema.json",
  "title": "Массовый импорт рецептов",
  "type": "object",
  "required": ["schemaVersion", "recipes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "ingredients", "steps"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "author": { "type": "string" },
          "servings": { "type": ["number", "null"] },
          "prepTimeMinutes": { "type": ["number", "null"] },
          "cookTimeMinutes": { "type": ["number", "null"] },
          "ingredients": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "amount": { "type": ["number", "string", "null"] }, "unit": { "type": "string" }, "note": { "type": "string" } } } },
          "steps": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } }] },
          "note": { "type": "string" },
          "familyStory": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "coverImage": { "$ref": "#/$defs/image" },
          "originalPageImages": { "type": "array", "items": { "$ref": "#/$defs/image" } }
        }
      }
    }
  },
  "$defs": { "image": { "type": "object", "properties": { "fileName": { "type": "string" }, "dataUrl": { "type": "string" }, "alt": { "type": "string" } }, "anyOf": [{ "required": ["fileName"] }, { "required": ["dataUrl"] }] } }
}
